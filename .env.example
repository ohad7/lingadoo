# Optional Google Analytics 4 measurement id.
# Example: VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Optional consent gate for deployments that require an analytics opt-in.
# When true, GA loads only after localStorage["lingadoo.analytics.consent"] is "granted".
VITE_GA_REQUIRE_CONSENT=false

# Optional link shown/documented as the public source location for deployments.
# Example: VITE_SOURCE_URL=https://github.com/YOUR_ORG/lingadoo
VITE_SOURCE_URL=
