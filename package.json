{
  "name": "lingadoo",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-first PDF translation and editing app that keeps the active document flow local.",
  "homepage": "https://lingadoo.app",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohad7/lingadoo.git"
  },
  "bugs": {
    "url": "https://github.com/ohad7/lingadoo/issues"
  },
  "keywords": [
    "pdf",
    "translation",
    "editor",
    "browser",
    "mupdf",
    "react",
    "vite"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "inspect:browser": "node ./scripts/inspect_editor_state.mjs",
    "e2e": "playwright test -c ./playwright.config.ts",
    "e2e:smoke": "playwright test -c ./playwright.config.ts --grep @smoke",
    "e2e:headed": "playwright test -c ./playwright.config.ts --headed",
    "e2e:server": "bash ./tests/e2e/scripts/start_e2e_server.sh",
    "e2e:report": "playwright show-report .test-artifacts/e2e/report"
  },
  "dependencies": {
    "mupdf": "^1.28.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.10"
  }
}
